# Copie para .env e preencha. O .env é ignorado pelo git.

# Canal API de LLM (porta LLMProvider)
OPENROUTER_API_KEY=

# Segredo dos tokens JWT (>= 32 bytes; troque em qualquer ambiente compartilhado)
JWT_SECRET=dev-secret-change-me-0123456789abcdef

# Banco (default aponta para o Postgres do docker-compose)
# DATABASE_URL=postgresql+psycopg://bsp:bsp@localhost:5432/bsp

# O harness Claude Code (porta CodeAnalysisEngine) usa a credencial
# já configurada na máquina (`claude` logado no PATH) — sem variável aqui.

# ---- Modelos (um por finalidade) ----
# Análises via API OpenRouter: tradução de evidence para negócio, detecção de conflitos,
# decomposição de regras e avaliador. NÃO é o harness.
OPENROUTER_MODEL=openai/gpt-5.6-luna
# Embeddings (recuperação e deduplicação semântica no pgvector)
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
# Harness Claude Code (discovery, inventário, corroboração): usa a assinatura do `claude`
# logado na máquina, não a OpenRouter. Aliases: opus | sonnet | haiku.
HARNESS_MODEL=opus
HARNESS_EFFORT=high
HARNESS_INVENTORY_EFFORT=medium
HARNESS_PROBE_MODEL=haiku
# Corroboração/busca de evidência é busca dirigida, não descoberta aberta: modelo barato.
HARNESS_CORROBORATION_MODEL=sonnet

# ---- Faixas de confiança ----
# Perfil de evidência padrão (pesos do Confidence Engine) quando o domain não escolhe um:
# default | legacy-hostile (ERP antigo sem docs/testes confiáveis: um arquivo de código já
# publica como provisório; dois fecham MEDIUM). Também por domain, na tela Admin.
EVIDENCE_PROFILE=default
# Cascata de evidência (estágio 1, mesma fonte) disparada ao fim de cada campanha dirigida.
EVIDENCE_SEARCH_AUTO=true
EVIDENCE_SEARCH_DELAY_MIN=5
EVIDENCE_SEARCH_MAX_BATCHES=3
# Exportar também os PROVISIONAL para o canonical-repo (pasta provisional/).
EXPORT_PROVISIONAL=false

# ---- Servidor MCP / assistente operacional ----
# URL da API vista pelo servidor MCP (roda no host) e pelo endpoint /assistant/chat
# (a API chama a si mesma, em loopback, com o JWT de quem perguntou).
BSP_API_URL=http://127.0.0.1:8000
# Credenciais do servidor MCP externo (Claude Code etc.): um usuário da plataforma — o RBAC
# dele limita o que o agente consegue fazer — OU um JWT pronto em BSP_TOKEN.
BSP_EMAIL=
BSP_PASSWORD=
# Modelo do assistente interno (tool calling via OpenRouter); vazio = OPENROUTER_MODEL.
ASSISTANT_MODEL=
# Chamadas de tool por pergunta (teto de custo e latência).
ASSISTANT_MAX_STEPS=12
