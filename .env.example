# Copie para .env e preencha. O .env é ignorado pelo git.

# Canal API de LLM (porta LLMProvider)
OPENROUTER_API_KEY=

# Segredo dos tokens JWT (>= 32 bytes; troque em qualquer ambiente compartilhado)
JWT_SECRET=dev-secret-change-me-0123456789abcdef

# Banco (default aponta para o Postgres do docker-compose)
# DATABASE_URL=postgresql+psycopg://bsp:bsp@localhost:5432/bsp

# O harness Claude Code (porta CodeAnalysisEngine) usa a credencial
# já configurada na máquina (`claude` logado no PATH) — sem variável aqui.

# ---- Modelos (um por finalidade) ----
# Análises via API OpenRouter: tradução de evidence para negócio, detecção de conflitos,
# decomposição de regras e avaliador. NÃO é o harness.
OPENROUTER_MODEL=openai/gpt-5.6-luna
# Embeddings (recuperação e deduplicação semântica no pgvector)
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
# Harness Claude Code (discovery, inventário, corroboração): usa a assinatura do `claude`
# logado na máquina, não a OpenRouter. Aliases: opus | sonnet | haiku.
HARNESS_MODEL=opus
HARNESS_EFFORT=high
HARNESS_INVENTORY_EFFORT=medium
HARNESS_PROBE_MODEL=haiku
